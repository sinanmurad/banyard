NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Contact address for takedown / legal requests (shown on the rules page)
NEXT_PUBLIC_LEGAL_EMAIL=legal@example.com
# Public URL of your site (used in the email confirmation link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Cloudflare Turnstile bot protection (free). Site key goes here;
# the secret key goes in Supabase > Authentication > Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
